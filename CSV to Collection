// ---------------------------------------
// Initialize DataTable
// ---------------------------------------
System.Data.DataTable dt = new System.Data.DataTable();

// Split column names input
string[] columns =
    ColumnsToInclude.Split(new char[] { ',' }, System.StringSplitOptions.RemoveEmptyEntries);

// ---------------------------------------
// Validate file
// ---------------------------------------
if (!System.IO.File.Exists(FilePath))
{
    throw new System.Exception("CSV file not found: " + FilePath);
}

// ---------------------------------------
// Read CSV file
// ---------------------------------------
using (System.IO.StreamReader sr = new System.IO.StreamReader(FilePath))
{
    string line;
    int currentRow = 0;
    string[] headers = null;

    while ((line = sr.ReadLine()) != null)
    {
        currentRow++;

        // Skip rows before header
        if (currentRow < HeaderRowIndex)
            continue;

        string[] fields = line.Split(',');

        // Header row
        if (headers == null)
        {
            headers = fields;

            // Create DataTable columns
            foreach (string col in columns)
            {
                string colName = col.Trim();

                int index = System.Array.FindIndex(
                    headers,
                    h => string.Equals(h.Trim(), colName, System.StringComparison.OrdinalIgnoreCase)
                );

                if (index >= 0 && !dt.Columns.Contains(colName))
                    dt.Columns.Add(colName, typeof(string));
            }

            continue;
        }

        // ---------------------------------------
        // Data row
        // ---------------------------------------
        System.Data.DataRow row = dt.NewRow();

        foreach (string col in columns)
        {
            string colName = col.Trim();

            int index = System.Array.FindIndex(
                headers,
                h => string.Equals(h.Trim(), colName, System.StringComparison.OrdinalIgnoreCase)
            );

            if (index >= 0 && index < fields.Length)
                row[colName] = fields[index].Trim();
        }

        dt.Rows.Add(row);
    }
}

// ---------------------------------------
// Assign to Blue Prism Collection output
// ---------------------------------------
ImportedCsv = dt;
