CSV Code
Message="";
DataTable dt;
dt = DataTable;
try
{
    StringBuilder csv = new StringBuilder();

    // Header row
    for (int i = 0; i < dt.Columns.Count; i++)
    {
        csv.Append(dt.Columns[i].ColumnName);
        if (i < dt.Columns.Count - 1)
            csv.Append(",");
    }
    csv.AppendLine();

    // Data rows
    foreach (DataRow row in dt.Rows)
    {
        for (int i = 0; i < dt.Columns.Count; i++)
        {
            string cell = row[i].ToString();
            // Escape commas & quotes
            if (cell.Contains(",") || cell.Contains("\""))
                cell = "\"" + cell.Replace("\"", "\"\"") + "\"";

            csv.Append(cell);
            if (i < dt.Columns.Count - 1)
                csv.Append(",");
        }
        csv.AppendLine();
    }

    // Write to file
    File.WriteAllText(OutputFilePath, csv.ToString(), Encoding.UTF8);
}
catch (Exception ex)
{
    Message = ex.Message;
}
