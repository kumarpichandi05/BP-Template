Generate HTML Report
Message = string.Empty;
HtmlContent = string.Empty;

try
{
    DataTable dt = (DataTable)ResultTable;

    StringBuilder html = new StringBuilder();

    html.Append("<html>");
    html.Append("<head>");
    html.Append("<style>");
    html.Append("table { border-collapse: collapse; width: 100%; font-family: Arial; }");
    html.Append("th, td { border: 1px solid #000; padding: 6px; text-align: left; }");
    html.Append("th { background-color: #f2f2f2; }");
    html.Append("</style>");
    html.Append("</head>");
    html.Append("<body>");

    html.Append("<h2>" + ReportTitle + "</h2>");
    html.Append("<p>Generated on: " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "</p>");

    html.Append("<table>");

    // Header row
    html.Append("<tr>");
    foreach (DataColumn col in dt.Columns)
    {
        html.Append("<th>" + col.ColumnName + "</th>");
    }
    html.Append("</tr>");

    // Data rows
    foreach (DataRow row in dt.Rows)
    {
        html.Append("<tr>");
        foreach (object cell in row.ItemArray)
        {
            html.Append("<td>" + cell.ToString() + "</td>");
        }
        html.Append("</tr>");
    }

    html.Append("</table>");
    html.Append("</body>");
    html.Append("</html>");

    HtmlContent = html.ToString();

    // Write HTML file
    File.WriteAllText(OutputFilePath, HtmlContent);
}
catch (Exception ex)
{
    Message = ex.Message;
}
